<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Desafío Bebras | Juego escolar</title>
<style>

:root{
  --ink:#25234a;--purple:#5b4bdb;--purple2:#7868f0;--yellow:#ffd84d;
  --blue:#39a9e8;--pink:#ef6a9b;--green:#36b985;--orange:#f39a42;
  --paper:#f4f5ff;--muted:#747493;--white:#fff;--red:#e85d75;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:"Trebuchet MS",Arial,sans-serif;min-height:100vh}
header{padding:30px 18px 25px;text-align:center;background:linear-gradient(125deg,#5142cf,#7968f0);color:white;border-bottom:7px solid var(--yellow);position:relative;overflow:hidden}
header:before,header:after{content:"";position:absolute;border-radius:50%;background:#ffffff16}
header:before{width:190px;height:190px;left:-50px;top:-100px}
header:after{width:150px;height:150px;right:-35px;bottom:-95px}
header h1{position:relative;margin:0;color:white;font-size:clamp(27px,4vw,42px);letter-spacing:.5px;text-shadow:0 3px 0 #34299b}
header p{position:relative;margin:9px 0 0;color:#eeeaff;font-size:15px}
main{max-width:1200px;margin:auto;padding:24px}
.scoreboard{display:grid;grid-template-columns:1fr;gap:14px;margin-bottom:16px}
.team{background:white;border:0;border-radius:20px;padding:16px;text-align:center;box-shadow:0 5px 0 #deddf5;cursor:default}
.team h2{margin:0 0 5px;font-size:17px;letter-spacing:1px;color:var(--purple)!important}
.score{font-size:42px;font-weight:900;color:var(--ink);line-height:1.1}
.team small{color:var(--muted);font-weight:600}
.toolbar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;background:white;padding:15px 18px;border-radius:17px;margin-bottom:24px;box-shadow:0 4px 0 #e0dff4}
.toolbar .group{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
button,select,input{font:inherit}
button{border:0;border-radius:12px;padding:11px 16px;font-weight:800;cursor:pointer;transition:transform .15s,filter .15s,box-shadow .15s}
button:hover{filter:brightness(1.04);transform:translateY(-2px)}
button:disabled{opacity:.65;cursor:not-allowed;transform:none}
.primary{background:var(--yellow);color:#3b2b00}
.bluebtn{background:var(--blue);color:#092c43}
.orangebtn{background:var(--orange);color:#462000}
.ghost{background:#ecebff;color:var(--purple)}
.good{background:#d8f8e9;color:#126b45}
.bad{background:#ffe3e9;color:#a82e4b}
select{background:#f1f0ff;color:var(--ink);border:2px solid #d8d5ff;border-radius:10px;padding:9px 12px;font-weight:700}
.section-title{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:22px 0 14px}
.section-title h2{margin:0;font-size:23px;color:var(--ink)}
.section-title span{background:#e4e1ff;color:#5142cf;font-weight:800;font-size:13px;padding:8px 12px;border-radius:20px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}
.challenge{background:white;border:0;border-radius:17px;padding:16px;cursor:pointer;min-height:124px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 5px 0 #deddf5;transition:transform .15s,box-shadow .15s}
.challenge:hover{transform:translateY(-3px);box-shadow:0 8px 0 #d5d2f2}
.challenge.selected{outline:3px solid var(--purple);outline-offset:2px}
.challenge.done{background:#e6f9f0;box-shadow:0 5px 0 #b8e9d1}
.challenge .num{display:inline-block;background:#f0eeff;color:var(--purple);font-size:11px;font-weight:900;letter-spacing:.8px;padding:5px 8px;border-radius:20px}
.challenge h3{font-size:18px;margin:10px 0;color:var(--ink)}
.challenge small{color:var(--muted);font-weight:700}
.status{font-size:11px;color:#168357;font-weight:900}
.game{display:none;background:white;border:0;border-radius:22px;padding:20px;margin-top:25px;box-shadow:0 6px 0 #deddf5}
.game.show{display:block}
.game-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;padding-bottom:13px;border-bottom:2px solid #f0effb}
.game-head h2{margin:0;color:var(--purple);font-size:23px}
.game-layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:20px;margin-top:18px;align-items:start}
.visual{background:#f5f5fb;border-radius:16px;padding:10px}
.visual img{width:100%;height:auto;display:block;border-radius:10px;background:white}
.question-panel{background:#f7f6ff;border:2px solid #ebe9ff;border-radius:17px;padding:18px}
.question-panel h3{display:inline-block;margin:0 0 12px;color:#fff;background:var(--purple);padding:7px 12px;border-radius:9px;font-size:13px;letter-spacing:1px}
.question{font-size:19px;line-height:1.45;margin:0 0 12px;font-weight:800;color:var(--ink)}
.skill{font-size:13px;color:var(--muted);margin-bottom:14px;font-weight:700}
.points-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:14px 0;padding:10px 12px;background:#fff4cc;border-radius:11px;color:#6b4d00}
.points-row label{font-size:13px;font-weight:700}
.answer{display:none;background:#e6f9f0;border-left:5px solid var(--green);padding:13px;border-radius:9px;line-height:1.45;margin:14px 0;color:#145c40;font-weight:700}
.answer.show{display:block}
.choices{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:14px 0}
.choice-btn{width:100%;min-height:70px;text-align:left;color:white;border:0;padding:14px;border-radius:13px;font-weight:800;line-height:1.35;box-shadow:0 4px 0 #00000020}
.choice-btn:nth-child(4n+1){background:#e85d75}
.choice-btn:nth-child(4n+2){background:#3e9fe6}
.choice-btn:nth-child(4n+3){background:#e9a13b}
.choice-btn:nth-child(4n+4){background:#39ae85}
.choice-btn:hover{filter:brightness(1.08);border:0}
.choice-btn:disabled{opacity:1;cursor:default}
.choice-btn.correct{background:#28a66f!important;outline:3px solid #b7f2d4}
.choice-btn.wrong{background:#b7b7c9!important;color:#fff;opacity:.7}
.answer strong{color:#116b46}
.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.notice{color:var(--muted);font-size:13px;line-height:1.4;margin:12px 0 0}
footer{text-align:center;color:#777697;font-size:12px;padding:28px 10px}
@media(max-width:760px){
 main{padding:14px}.game-layout{grid-template-columns:1fr}.score{font-size:36px}
 .toolbar{align-items:flex-start}.choices{grid-template-columns:1fr}
 .section-title{align-items:flex-start;flex-direction:column}
}

</style>
</head>
<body>
<header>
  <h1>🐝 DESAFÍO BEBRAS</h1>
  <p>🎓 ¡Aprendé jugando! · Pensamiento computacional · 14 desafíos</p>
</header>
<main>
  <section class="scoreboard" style="grid-template-columns:1fr">
    <div class="team active" id="participant">
      <h2 style="color:var(--yellow)">🐝 MI PUNTUACIÓN</h2>
      <div class="score" id="score">0</div><small>puntos acumulados</small>
    </div>
  </section>
  <section class="toolbar">
    <div class="group"><strong>Participante:</strong><span>🐝 Jugador/a</span></div>
    <div class="group">
      <label for="points">Puntos por acierto:</label>
      <select id="points"><option value="10">10 puntos</option><option value="20">20 puntos</option><option value="30">30 puntos</option></select>
      <button class="bad" onclick="resetGame()">Reiniciar todo</button>
    </div>
  </section>
  <div class="section-title"><h2>Elegí un desafío</h2><span id="progress">0 de 14 resueltos</span></div>
  <section class="cards" id="cards"></section>
  <section class="game" id="game">
    <div class="game-head"><h2 id="gameTitle">Desafío</h2><button class="ghost" onclick="closeChallenge()">Volver a los desafíos</button></div>
    <div class="game-layout">
      <div class="visual"><img id="challengeImage" alt="Tarjeta original del desafío Bebras"></div>
      <div class="question-panel">
        <h3>CONSIGNA</h3>
        <p class="question" id="question"></p>
        <div class="skill" id="skill"></div>
        <div class="points-row"><label>Premio por respuesta correcta:</label><strong id="pointsLabel">10 puntos</strong></div>
        <div id="choices" class="choices"></div>
        <div class="answer" id="answer" aria-live="polite"></div>
        <p class="notice">Elegí una opción. Si es correcta, los puntos se suman automáticamente. Si te equivocás, podés volver a intentarlo.</p>
      </div>
    </div>
  </section>
</main>
<footer>Material de aula basado en las tarjetas Bebras 2026 de Ceibal · ¡Pensá, elegí y sumá puntos!</footer>
<script>
const challenges = [{"id": 1, "title": "Huellas", "question": "¿De qué animal robot es la huella?", "answer": "El robot naranja de orejas largas.", "skill": "Abstracción", "image": "data:image/jpeg;base64,"}, {"id": 2, "title": "Agentes secretos", "question": "Bruno quiere enviar la palabra PELOTA usando la regla de reemplazar cada letra por la siguiente del alfabeto. ¿Qué debe escribir?", "answer": "QFMPUB.", "skill": "Pensamiento algorítmico y descomposición", "image": "data:image/jpeg;base64,"}, {"id": 3, "title": "Castores educados", "question": "¿Qué auto entrará inmediatamente después del que indica la consigna?", "answer": "El 4.º auto de la calle Sol.", "skill": "Pensamiento algorítmico", "image": "data:image/jpeg;base64,"}, {"id": 4, "title": "Búsqueda del tesoro", "question": "¿Dónde está escondido el tesoro?", "answer": "En la CUEVA.", "skill": "Descomposición y reconocimiento de patrones", "image": "data:image/jpeg;base64,"}, {"id": 5, "title": "Adornos navideños", "question": "¿En qué orden se abrieron las cajas?", "answer": "C → A → D → B.", "skill": "Pensamiento algorítmico y secuencias", "image": "data:image/jpeg;base64,"}, {"id": 6, "title": "Cuadrados para colorear", "question": "¿Cuántos cuadrados en total coloreó Ema?", "answer": "9 cuadrados.", "skill": "Descomposición", "image": "data:image/jpeg;base64,"}, {"id": 7, "title": "El tesoro de Ale", "question": "¿Qué camino lleva a Ale al tesoro respetando todas las reglas?", "answer": "Hay más de una solución posible. La tarjeta de soluciones del material muestra una ruta válida.", "skill": "Pensamiento algorítmico y restricciones", "image": "data:image/jpeg;base64,"}, {"id": 8, "title": "Nutrias nadadoras", "question": "¿Qué dos nutrias deben separarse en la primera división para que todas lleguen a su casa?", "answer": "Las nutrias B y C.", "skill": "Pensamiento algorítmico", "image": "data:image/jpeg;base64,"}, {"id": 9, "title": "Mesa de comedor", "question": "¿Quién está sentado frente a David?", "answer": "Ana.", "skill": "Abstracción y razonamiento lógico", "image": "data:image/jpeg;base64,"}, {"id": 10, "title": "Caperucita Roja", "question": "¿Qué recorrido le permite llegar a la casa de su abuela con la mayor cantidad de galletas?", "answer": "El camino zorro → zorrillo.", "skill": "Evaluación y optimización de recursos", "image": "data:image/jpeg;base64,"}, {"id": 11, "title": "Llevando palos", "question": "¿Cuántos palos llevará Celina según las luces encendidas?", "answer": "6 palos.", "skill": "Abstracción y pensamiento algorítmico", "image": "data:image/jpeg;base64,"}, {"id": 12, "title": "Hora de la merienda", "question": "Según las reglas del problema, ¿qué alimentos tiene permitido elegir Mariana para el día 3?", "answer": "Manzanas y peras.", "skill": "Pensamiento algorítmico y condicionales", "image": "data:image/jpeg;base64,"}, {"id": 13, "title": "Viaje a casa de los abuelos", "question": "¿Cuál es el camino más corto desde la ciudad A hasta la ciudad F?", "answer": "A → B → D → E → F.", "skill": "Pensamiento algorítmico y optimización", "image": "data:image/jpeg;base64,"}, {"id": 14, "title": "La llave inglesa", "question": "¿Cuál es el número mínimo de llaves que debe probar para garantizar que encontrará la correcta?", "answer": "4 llaves.", "skill": "Pensamiento algorítmico y búsqueda", "image": "data:image/jpeg;base64,"}];
const choicesById = {
  1: ["El robot naranja de orejas largas.", "El robot azul de cuatro patas iguales.", "El robot verde con ruedas.", "El robot violeta de patas redondas."],
  2: ["QFMPUB", "PELOTB", "QFKNTA", "OFMPUA"],
  3: ["El 2.º auto de la calle Sol.", "El 4.º auto de la calle Sol.", "El 3.º auto de la calle Corazón.", "El 1.º auto de la calle Corazón."],
  4: ["En el bosque.", "En la cueva.", "En la montaña.", "En el río."],
  5: ["A → B → C → D", "B → D → A → C", "C → A → D → B", "D → C → B → A"],
  6: ["6 cuadrados.", "8 cuadrados.", "9 cuadrados.", "12 cuadrados."],
  7: ["Una ruta que evita el agua, pasa por al menos una montaña y se mueve solo arriba, abajo, izquierda o derecha.", "Una ruta que puede cruzar el agua si es el camino más corto.", "Una ruta que pasa por el agua y no necesita tocar montañas.", "Una ruta que permite moverse en diagonal y evita las montañas."],
  8: ["Las nutrias A y B.", "Las nutrias B y C.", "Las nutrias C y D.", "Las nutrias D y E."],
  9: ["Bruno.", "Clara.", "Ana.", "David."],
  10: ["El camino oso → zorro.", "El camino zorro → zorrillo.", "El camino lobo → oso.", "El camino zorrillo → lobo."],
  11: ["3 palos.", "4 palos.", "5 palos.", "6 palos."],
  12: ["Mangos y bananas.", "Bananas y manzanas.", "Manzanas y peras.", "Peras y mangos."],
  13: ["A → C → F", "A → B → D → E → F", "A → D → C → E → F", "A → B → C → F"],
  14: ["2 llaves.", "3 llaves.", "4 llaves.", "5 llaves."]
};
let score=0, selected=null, completed=new Set();
const cardsEl=document.getElementById('cards');
function renderCards(){
  cardsEl.innerHTML=challenges.map(c=>`<article class="challenge ${completed.has(c.id)?'done':''} ${selected===c.id?'selected':''}" onclick="openChallenge(${c.id})">
    <div><div class="num">DESAFÍO ${String(c.id).padStart(2,'0')}</div><h3>${c.title}</h3></div>
    <div>${completed.has(c.id)?'<span class="status">✓ RESUELTO</span>':'<small>Ver consigna →</small>'}</div>
  </article>`).join('');
  document.getElementById('progress').textContent=`${completed.size} de ${challenges.length} resueltos`;
}
function updateScoreboard(){
  document.getElementById('score').textContent=score;
  document.getElementById('pointsLabel').textContent=document.getElementById('points').value+' puntos';
}
function openChallenge(id){
  selected=id;const c=challenges.find(x=>x.id===id);
  document.getElementById('gameTitle').textContent=`Desafío ${id}: ${c.title}`;
  document.getElementById('question').textContent=c.question;
  document.getElementById('skill').textContent='Habilidad de pensamiento computacional: '+c.skill;
  document.getElementById('challengeImage').src=c.image;
  document.getElementById('answer').classList.remove('show');
  document.getElementById('answer').textContent='';
  renderChoices(c);
  document.getElementById('game').classList.add('show');
  renderCards();
  document.getElementById('game').scrollIntoView({behavior:'smooth',block:'start'});
}
function renderChoices(c){
  const container=document.getElementById('choices');
  const options=choicesById[c.id];
  container.innerHTML=options.map((option,index)=>
    `<button class="choice-btn" type="button" onclick="chooseAnswer(${index})">${String.fromCharCode(65+index)}. ${option}</button>`
  ).join('');
  if(completed.has(c.id)){
    container.querySelectorAll('button').forEach(btn=>btn.disabled=true);
    document.getElementById('answer').textContent='Este desafío ya fue resuelto correctamente.';
    document.getElementById('answer').classList.add('show');
  }
}
function chooseAnswer(index){
  if(selected===null || completed.has(selected))return;
  const c=challenges.find(x=>x.id===selected);
  const chosen=choicesById[c.id][index];
  const correct=chosen===c.answer;
  const buttons=[...document.querySelectorAll('#choices .choice-btn')];
  buttons.forEach((btn,i)=>{
    btn.classList.remove('correct','wrong');
    if(i===index)btn.classList.add(correct?'correct':'wrong');
    btn.disabled=correct;
  });
  const feedback=document.getElementById('answer');
  feedback.classList.add('show');
  if(correct){
    const earned=Number(document.getElementById('points').value);
    score+=earned;
    completed.add(selected);
    updateScoreboard();
    renderCards();
    feedback.innerHTML=`<strong>¡Correcto! +${earned} puntos.</strong> ¡Muy bien!`;
    buttons.forEach(btn=>btn.disabled=true);
  }else{
    feedback.innerHTML='<strong style="color:#ffb2a8">No es correcto.</strong> Probá nuevamente con otra opción.';
  }
}
function closeChallenge(){document.getElementById('game').classList.remove('show');selected=null;renderCards()}
function resetGame(){
  if(!confirm('¿Querés reiniciar los puntajes y el progreso de los 14 desafíos?'))return;
  score=0;selected=null;completed.clear();
  document.getElementById('game').classList.remove('show');updateScoreboard();renderCards();
}
document.getElementById('points').addEventListener('change',updateScoreboard);
renderCards();updateScoreboard();
</script>
</body>
</html>
